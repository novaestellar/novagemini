# Normalisasi akhir baris: repo simpan LF, Windows checkout tetap LF
# supaya skrip shell dan file .go tidak pernah bertabrakan.
* text=auto eol=lf

# Sumber
*.go   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.svg  text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.py   text eol=lf

# Skrip Windows butuh CRLF agar cmd.exe dan PowerShell tidak salah baca
*.ps1  text eol=crlf
*.bat  text eol=crlf

# Biner: jangan pernah dinormalisasi
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.exe  binary
*.db   binary
