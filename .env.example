# NovaGemini 环境变量配置
# 复制为 .env 后按需填值。.env 不入库(见 .gitignore)。
#
# 这三个变量是进程启动时读取的,改了必须重启才生效。
# 运行时的调优项(默认模型、限流、指纹、保留天数…)在管理面板「设置」页改,
# 保存即生效,不走这里。
#
# 全部可选:NovaGemini 一个变量都不配也能直接跑。

# ─── 鉴权 ─────────────────────────────────────────────
# 管理面板登录 token。留空 = 面板不鉴权,仅当只监听 127.0.0.1 时可接受。
ADMIN_TOKEN=

# 锁定 /v1/* 的 API key。设了就锁死,面板改不了(用于不希望运行时被改的部署)。
# 留空则首次启动自动生成,完整值在管理面板「设置」页。
# API_KEY=sk-gemini-xxxxxxxx

# ─── 数据库 ───────────────────────────────────────────
# 不设 = SQLite,路径 ./data/gemini.db(可用 config.json / --db 改)。
# 单机就用 SQLite;多实例共享一个池子才需要 MySQL / PostgreSQL。
# 建表自动完成,三种库共用同一套 schema。
# SQL_DSN=mysql://user:pass@host:3306/dbname
# SQL_DSN=postgres://user:pass@host:5432/dbname?sslmode=disable

# ─── 端口 / path 等不在环境变量里 ─────────────────────
# 端口、绑定地址、DB 路径走 config.json 或命令行参数:
#   --port 8083        监听端口
#   --db ./data/gemini.db   SQLite 路径
#   --admin-token ...   等价于 ADMIN_TOKEN
#   --api-key ...       等价于 API_KEY
# 详见 README「配置」一节。
