# NovaGemini 环境变量模板
#
# 用法：复制成 .env 再填值。.env 不入库（见 .gitignore）。
# 容器/进程管理器可以直接注入同名环境变量，不一定需要 .env 文件。
# 优先级：环境变量 > config.json 里的同名字段。

# ── 面板访问密码 ────────────────────────────────────────────────
# 留空 = 面板无密码（只建议绑 127.0.0.1 时这么做）。
# 一旦要暴露到内网其他机器或公网，先设强密码，再走反向代理 + HTTPS。
ADMIN_TOKEN=

# ── API Key ────────────────────────────────────────────────────
# /v1/* 全部走这个 key。留空则首次启动自动生成，可在面板「设置」页查看与修改。
API_KEY=

# ── 数据库 ─────────────────────────────────────────────────────
# 留空 = SQLite，落在 ./data/gemini.db。
# 多机共享或多实例请改用 MySQL / PostgreSQL；SQLite 不适合并发写。
# SQL_DSN=mysql://user:pass@host:3306/dbname
# SQL_DSN=postgres://user:pass@host:5432/dbname?sslmode=disable

# ── 监听 ──────────────────────────────────────────────────────
# 只在本机用就保持 127.0.0.1。要让局域网访问才改 0.0.0.0，
# 并同时确认 ADMIN_TOKEN 已设置。
HOST=127.0.0.1
PORT=8083
